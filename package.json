{
  "name": "fond-ecran-jour-nuit",
  "version": "0.4.2",
  "private": true,
  "os": ["darwin", "win32"],
  "description": "Fond d’écran WebGL jour/nuit avec distributions séparées pour macOS et Windows/Lively.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate.mjs",
    "package:windows": "powershell -NoProfile -File scripts/package-windows.ps1",
    "package:macos": "bash platforms/macos/build-macos.sh"
  },
  "engines": {
    "node": ">=18"
  }
}
